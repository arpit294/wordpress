msgstr "Bedankt skin (legacy-tq-layout of modern-tq-layout)."

#: abilities/class-cartflows-ability-config.php:2094
msgid "Section visibility toggles (show_overview, show_details, show_billing, show_shipping)."
msgstr "Sectiezichtbaarheid schakelaars (toon_overzicht, toon_details, toon_facturering, toon_verzending)."

