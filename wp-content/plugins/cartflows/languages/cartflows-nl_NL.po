#, js-format
msgid "Importing %s…"
msgstr "%s importeren…"

#: admin-core/assets/build/onboarding-app.js:6
msgid "Store checkout templates"
msgstr "Sjablonen voor winkelafrekenen"

#. translators: %d: carousel position number.
#: admin-core/assets/build/onboarding-app.js:7
#, js-format
msgid "Go to templates position %d"
msgstr "Ga naar sjabloonpositie %d"

#: admin-core/assets/build/onboarding-app.js:7
msgid "Make it yours"
msgstr "Maak het eigen"

#: admin-core/assets/build/onboarding-app.js:7
msgid "Optional — add your logo and brand colour. Leave the colour empty to keep the template design."
msgstr "Optioneel — voeg je logo en merkkleur toe. Laat de kleur leeg om het sjabloonontwerp te behouden."

#: admin-core/assets/build/onboarding-app.js:7
msgid "Brand Color"
msgstr "Merkkleur"

#: admin-core/assets/build/onboarding-app.js:7
msgid "Importing your store checkout — this usually takes 15–20 seconds. Please keep this window open."
msgstr "Je winkelafrekenpagina wordt geïmporteerd — dit duurt meestal 15–20 seconden. Houd dit venster open."

#: admin-core/assets/build/onboarding-app.js:7
msgid "You can import a checkout template later from CartFlows → Store Checkout."
msgstr "Je kunt later een afrekensjabloon importeren via CartFlows → Winkelafrekenen."

#: admin-core/assets/build/onboarding-app.js:7
msgid "Back to templates"
msgstr "Terug naar sjablonen"

#: admin-core/assets/build/onboarding-app.js:7
msgid "Let CartFlows take the guesswork out of your checkout results. Each week your store will send you an email report with key metrics and insights."
msgstr "Laat CartFlows het giswerk uit je afrekenresultaten halen. Elke week stuurt je winkel je een e-mailrapport met belangrijke statistieken en inzichten."

#: admin-core/assets/build/onboarding-app.js:7
msgid "View Your Store Checkout"
msgstr "Bekijk je winkelafrekenpagina"

#: admin-core/assets/build/onboarding-app.js:7
msgid "Connect a payment gateway to take payments"
msgstr "Koppel een betaalgateway om betalingen te ontvangen"

#: admin-core/assets/build/onboarding-app.js:7
msgid "Add your logo and brand colour"
