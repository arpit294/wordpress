msgstr "Mijn afrekenpagina bouwen"

#: admin-core/assets/build/onboarding-app.js:2
msgid "Pick optional add-ons like cart abandonment recovery"
msgstr "Kies optionele add-ons zoals herstel van verlaten winkelwagens"

#: admin-core/assets/build/onboarding-app.js:2
msgid "Get weekly email reports on how your store is doing"
msgstr "Ontvang wekelijkse e-mailrapporten over hoe je winkel presteert"

#: admin-core/assets/build/onboarding-app.js:2
msgid "≈ 2 min setup"
msgstr "≈ 2 min. installatie"

#: admin-core/assets/build/onboarding-app.js:2
msgid "Not Activated"
msgstr "Niet geactiveerd"

#: admin-core/assets/build/onboarding-app.js:2
msgid "Installing Plugins…"
msgstr "Plugins installeren…"

#: admin-core/assets/build/onboarding-app.js:2
msgid "Great job! Now let's set up a few plugins."
msgstr "Goed gedaan! Laten we nu een paar plugins instellen."

#: admin-core/assets/build/onboarding-app.js:2
msgid "WooCommerce is required to power your checkout. Everything else is optional — tick the ones you want and we'll install and activate them for you."
msgstr "WooCommerce is vereist om je afrekenpagina aan te drijven. Al het andere is optioneel — vink aan wat je wilt en wij installeren en activeren het voor je."

#: admin-core/assets/build/onboarding-app.js:3
#: admin-core/assets/build/settings-app.js:140
msgid "Retry"
msgstr "Opnieuw proberen"

#. translators: %d: number of plugins to install.
#: admin-core/assets/build/onboarding-app.js:4
#, js-format
msgid "Continuing will install and activate %d selected plugin."
msgid_plural "Continuing will install and activate %d selected plugins."
msgstr[0] "Als je doorgaat, wordt %d geselecteerde plugin geïnstalleerd en geactiveerd."
msgstr[1] "Als je doorgaat, worden %d geselecteerde plugins geïnstalleerd en geactiveerd."

#. translators: 1: activated plugin count, 2: total plugin count.
#: admin-core/assets/build/onboarding-app.js:5
#, js-format
msgid "Installing plugins… %1$d of %2$d complete. This can take a minute."
msgstr "Plugins installeren… %1$d van %2$d voltooid. Dit kan een minuut duren."

