msgstr "Vorlagentyp: \"free\" oder \"pro\"."

#: abilities/class-cartflows-ability-config.php:3307
msgid "Page builder slug."
msgstr "Seiten-Builder-Slug."

#: abilities/class-cartflows-ability-config.php:3311
msgid "Whether this template requires CartFlows Pro."
msgstr "Ob diese Vorlage CartFlows Pro erfordert."

#: abilities/class-cartflows-ability-config.php:3315
msgid "Category slugs for this template."
msgstr "Kategorienschlüssel für diese Vorlage."

#: abilities/class-cartflows-ability-config.php:3322
msgid "Number of steps in this template."
msgstr "Anzahl der Schritte in dieser Vorlage."

#: abilities/class-cartflows-ability-config.php:3326
